; SPDX-License-Identifier: Apache-2.0
; Pen-only native app_domain/bluetooth_domain/HAL expansion. Parent must strict-link before image integration.
; Extracted from pinned crDroid 20261017 system_ext CIL; private guard names are locally namespaced.
(type pen_app)
(roletype object_r pen_app)
(type pen_app_userfaultfd)
(roletype object_r pen_app_userfaultfd)
(type pen_app_block_io_uring)
(roletype object_r pen_app_block_io_uring)
(type pen_app_wrapfd)
(roletype object_r pen_app_wrapfd)
(typeattributeset domain (pen_app))
(typeattributeset appdomain (pen_app))
(typeattributeset bluetoothdomain (pen_app))
(typeattributeset coredomain (pen_app))
(typeattributeset halclientdomain (pen_app))
(typeattributeset vendor_hal_oplus_touch_client (pen_app))
(typeattribute pen_app_source_guard_4)
(typeattributeset pen_app_source_guard_4 (not (system_server_wrapfd pen_app_userfaultfd ) ))
(typeattribute pen_app_source_guard_3)
(typeattributeset pen_app_source_guard_3 (and (domain ) (not (crash_dump llkd runas_app simpleperf pen_app ))))
(typeattribute pen_app_source_guard_2)
(typeattributeset pen_app_source_guard_2 (and (appdomain ) (not (runas_app shell simpleperf pen_app ))))
(typeattribute pen_app_source_guard_1)
(typeattributeset pen_app_source_guard_1 (and (pen_app ) (not (runas_app shell simpleperf ))))
(typeattribute pen_app_source_guard_0)
(typeattributeset pen_app_source_guard_0 (and (domain ) (not (pen_app ))))
(typetransition pen_app tmpfs file appdomain_tmpfs)
(allow pen_app pen_app_userfaultfd (anon_inode (ioctl read create)))
(dontaudit su pen_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow pen_app_source_guard_0 pen_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(allow pen_app appdomain_tmpfs (file (read write getattr map execute)))
(allow pen_app appdomain (memfd_file (read write getattr map execute)))
(neverallow pen_app_source_guard_1 pen_app_source_guard_0 (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow pen_app_source_guard_2 pen_app (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow pen_app_source_guard_3 pen_app (process (ptrace)))
(neverallow pen_app pen_app_source_guard_4 (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(allow pen_app vendor_hal_oplus_touch (memfd_file (read write getattr map)))
(allow vendor_hal_oplus_touch pen_app (memfd_file (read write getattr map)))
(allow pen_app self (netlink_kobject_uevent_socket (read create bind setopt)))
(allow pen_app app_api_service (service_manager (find)))
(typetransition pen_app pen_app anon_inode "[wrapfd]" pen_app_wrapfd)
(typetransition pen_app pen_app anon_inode "[io_uring]" pen_app_block_io_uring)
(typetransition pen_app pen_app anon_inode "[userfaultfd]" pen_app_userfaultfd)
