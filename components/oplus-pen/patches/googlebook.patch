+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.pen
+
+// A successful read with a null value is distinct from an unavailable Settings provider.
+data class PeakValue(val raw: String?)
+data class PeakState(val previous: PeakValue? = null, val overridden: Boolean = false)
+
+interface PeakCapStore {
+    fun canWrite(): Boolean
+    fun readPeak(): PeakValue?
+    fun writePeak(expected: PeakValue, value: PeakValue): Boolean
+    fun loadState(): PeakState?
+    fun saveState(state: PeakState): Boolean
+}
+
+class PeakCap(private val store: PeakCapStore) {
+    private var state = store.loadState()
+
+    fun update(active: Boolean) {
+        val saved = state ?: return
+        val current = store.readPeak() ?: return
+        if (saved.overridden) {
+            if (!active) abandon(false)
+            return
+        }
+        val previous = saved.previous
+        if (previous != null) {
+            if (current != CAP) {
+                abandon(active) // Owner changes take precedence, including a pending pre-write journal.
+                return
+            }
+            if (!active) restore(previous)
+            return
+        }
+        if (!active || !store.canWrite()) return
+        val rate = current.raw?.toFloatOrNull()
+        if (current.raw != null && (rate == null || !rate.isFinite() || rate <= 120f)) return
+        // Commit the owner's exact value, including unset, before changing the public setting.
+        if (!save(PeakState(previous = current))) return
+        if (store.readPeak() != current) {
+            abandon(true)
+            return
+        }
+        if (!store.canWrite()) {
+            abandon(false)
+            return
+        }
+        val written = store.writePeak(current, CAP)
+        val after = store.readPeak()
+        if (!written && after == current) abandon(false)
+        else if (after != null && after != CAP) abandon(true)
+    }
+
+    fun stop() {
+        if (state?.overridden == false) update(false)
+    }
+
+    private fun restore(previous: PeakValue) {
+        if (!store.canWrite()) return
+        val before = store.readPeak() ?: return
+        if (before != CAP) {
+            abandon(false)
+            return
+        }
+        val written = store.writePeak(CAP, previous)
+        val after = store.readPeak()
+        if (written && after == previous) abandon(false)
+        else if (after != null && after != CAP) abandon(false)
+        // Failed/denied restoration keeps the durable desired value for a later legitimate retry.
+    }
+
+    private fun save(next: PeakState): Boolean {
+        if (!store.saveState(next)) return false
+        state = next
+        return true
+    }
+
+    private fun abandon(active: Boolean) {
+        val next = PeakState(overridden = active)
+        state = next // Respect an observed owner override even if persisting it fails.
+        store.saveState(next)
+    }
+
+    companion object {
+        private val CAP = PeakValue("120.0")
+    }
+}
