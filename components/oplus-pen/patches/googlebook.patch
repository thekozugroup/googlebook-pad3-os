@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.pen
+
+import java.util.concurrent.atomic.AtomicBoolean
+
+// Lifecycle and Bluetooth permission boundary, independent of Android for host tests.
+class PenRuntime(private val hasAccess: () -> Boolean, private val onRefused: () -> Unit) {
+    private val refused = AtomicBoolean(false)
+    @Volatile private var started = false
+
+    fun start(initialise: () -> Unit): Boolean {
+        if (refused.get() || !hasAccess()) {
+            refuse()
+            return false
+        }
+        if (!started) {
+            started = true
+            initialise()
+        }
+        return !refused.get()
+    }
+
+    fun available(): Boolean {
+        if (refused.get() || !started) return false
+        if (!hasAccess()) {
+            refuse()
+            return false
+        }
+        return true
+    }
+
+    fun runIfAllowed(action: () -> Unit) {
+        if (available()) action()
+    }
+
+    fun <T> bluetooth(action: () -> T): T? {
+        if (!available()) return null
+        return try {
+            action()
+        } catch (error: SecurityException) {
+            if (hasAccess()) throw error
+            refuse()
+            null
+        }
+    }
+
+    // Closing a live GATT/scan must still be attempted after permission revocation.
+    fun cleanupBluetooth(action: () -> Unit) {
+        try {
+            action()
+        } catch (error: SecurityException) {
+            if (hasAccess()) throw error
+            refuse()
+        }
+    }
+
+    fun stop(cleanup: () -> Unit) {
+        refused.set(true)
+        if (started) {
+            started = false
+            cleanup()
+        }
+    }
+
+    private fun refuse() {
+        if (refused.compareAndSet(false, true)) onRefused()
+    }
+
+    companion object {
+        fun userAllowed(headless: Boolean, systemUser: Boolean) = !(headless && systemUser)
+        fun canStart(headless: Boolean, systemUser: Boolean, connect: Boolean, scan: Boolean, unlocked: Boolean) =
+            userAllowed(headless, systemUser) && connect && scan && unlocked
+
+        fun acceptsAction(action: String?) = action == "android.intent.action.BOOT_COMPLETED" ||
+            action == "android.intent.action.USER_UNLOCKED" ||
+            action == "android.intent.action.USER_FOREGROUND"
+    }
+}
