+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.pen
+
+import android.content.Context
+import android.database.ContentObserver
+import android.os.Handler
+import android.provider.Settings
+import android.util.Log
+
+class PenRefreshRateCap(context: Context, handler: Handler, changed: () -> Unit) {
+    private val resolver = context.contentResolver
+    private val preferences by lazy { context.getSharedPreferences("pen_peak_refresh_cap", Context.MODE_PRIVATE) }
+    private val policy = PeakCap(object : PeakCapStore {
+        override fun canWrite(): Boolean = try {
+            Settings.System.canWrite(context)
+        } catch (_: SecurityException) {
+            Log.w(TAG, "Peak preference write access unavailable")
+            false
+        }
+
+        override fun readPeak(): PeakValue? = try {
+            PeakValue(Settings.System.getString(resolver, KEY))
+        } catch (_: SecurityException) {
+            Log.w(TAG, "Peak preference cannot be read")
+            null
+        } catch (_: IllegalStateException) {
+            Log.w(TAG, "Peak preference provider unavailable")
+            null
+        }
+
+        override fun writePeak(expected: PeakValue, value: PeakValue): Boolean {
+            if (!canWrite() || readPeak() != expected) return false
+            // Settings has no public compare-and-set; recheck immediately before the permitted write.
+            return try {
+                Settings.System.putString(resolver, KEY, value.raw).also {
+                    if (!it) Log.w(TAG, "Peak preference write failed")
+                }
+            } catch (_: SecurityException) {
+                Log.w(TAG, "Peak preference write refused")
+                false
+            } catch (_: IllegalStateException) {
+                Log.w(TAG, "Peak preference provider unavailable")
+                false
+            }
+        }
+
+        override fun loadState(): PeakState? {
+            return try {
+            if (!preferences.contains("version")) PeakState()
+            else if (preferences.getInt("version", 0) != 1) null
+            else {
+                val previous = if (preferences.getBoolean("has_lease", false)) {
+                    if (preferences.getBoolean("had_value", false)) {
+                        val value = preferences.getString("previous", null)
+                        val rate = value?.toFloatOrNull()
+                        if (rate == null || !rate.isFinite() || rate <= 120f) return null
+                        PeakValue(value)
+                    } else PeakValue(null)
+                } else null
+                val overridden = preferences.getBoolean("overridden", false)
+                if (previous != null && overridden) null else PeakState(previous, overridden)
+            }
+        } catch (_: ClassCastException) {
+            Log.w(TAG, "Peak preference journal invalid")
+            null
+        } catch (_: IllegalStateException) {
+            Log.w(TAG, "Private peak preference journal unavailable")
+            null
+        }
+
+        }
+
+        override fun saveState(state: PeakState): Boolean = try {
+            val editor = preferences.edit().clear()
+                .putInt("version", 1)
+                .putBoolean("has_lease", state.previous != null)
+                .putBoolean("had_value", state.previous?.raw != null)
+                .putBoolean("overridden", state.overridden)
+            state.previous?.raw?.let { editor.putString("previous", it) }
+            editor.commit().also { if (!it) Log.w(TAG, "Peak preference journal save failed") }
+        } catch (_: IllegalStateException) {
+            Log.w(TAG, "Private peak preference journal unavailable")
+            false
+        }
+    })
+    private var observing = false
+    private val observer = object : ContentObserver(handler) {
+        override fun onChange(selfChange: Boolean) { changed() }
+    }
+
+    fun start() {
+        try {
+            resolver.registerContentObserver(Settings.System.getUriFor(KEY), false, observer)
+            observing = true
+        } catch (_: SecurityException) {
+            Log.w(TAG, "Peak preference observation unavailable")
+        }
+    }
+
+    fun update(active: Boolean) { policy.update(active) }
+
+    fun stop() {
+        if (observing) {
+            observing = false
+            resolver.unregisterContentObserver(observer)
+        }
+        policy.stop()
+    }
+
+    companion object {
+        private const val KEY = "peak_refresh_rate"
+        private const val TAG = "OplusPenRefreshCap"
+    }
+}
