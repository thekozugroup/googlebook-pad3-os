@@ -0,0 +1,57 @@
+package io.github.samson910022.pixelifyphotos
+
+import android.content.SharedPreferences
+import java.io.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class BinderSafePreferencesTest {
+    private class Recorder : SharedPreferences.Editor {
+        var received: MutableSet<String>? = null
+        var applied = false
+        override fun putStringSet(key: String?, values: MutableSet<String>?) = apply { received = values }
+        override fun putString(key: String?, value: String?) = this
+        override fun putInt(key: String?, value: Int) = this
+        override fun putLong(key: String?, value: Long) = this
+        override fun putFloat(key: String?, value: Float) = this
+        override fun putBoolean(key: String?, value: Boolean) = this
+        override fun remove(key: String?) = this
+        override fun clear() = this
+        override fun commit() = false
+        override fun apply() { applied = true }
+    }
+
+    @Test fun emptySetCrossesBootClassLoaderBoundaryAfterChainedEdit() {
+        val target = Recorder()
+        val editor: SharedPreferences.Editor = BinderSafeEditor(target)
+        assertSame(editor, editor.putBoolean("flag", true))
+        assertSame(editor, editor.putStringSet("set", emptySet()))
+        assertEquals(java.util.HashSet::class.java, target.received!!.javaClass)
+        val bytes = ByteArrayOutputStream().also { out -> ObjectOutputStream(out).use { it.writeObject(target.received) } }.toByteArray()
+        val restored = object : ObjectInputStream(ByteArrayInputStream(bytes)) {
+            override fun resolveClass(desc: ObjectStreamClass): Class<*> {
+                if (desc.name.startsWith("kotlin.")) throw ClassNotFoundException(desc.name)
+                return super.resolveClass(desc)
+            }
+        }.use { it.readObject() }
+        assertEquals(emptySet<String>(), restored)
+    }
+
+    @Test fun nullRemovalAndCommitApplySemanticsArePreserved() {
+        val target = Recorder()
+        val editor: SharedPreferences.Editor = BinderSafeEditor(target)
+        editor.putStringSet("set", setOf("one", "two"))
+        assertEquals(setOf("one", "two"), target.received)
+        assertSame(editor, editor.putString("string", "value"))
+        assertSame(editor, editor.putInt("int", 1))
+        assertSame(editor, editor.putLong("long", 1))
+        assertSame(editor, editor.putFloat("float", 1f))
+        assertSame(editor, editor.remove("remove"))
+        assertSame(editor, editor.clear())
+        editor.putStringSet("set", null)
+        assertNull(target.received)
+        assertFalse(editor.commit())
+        editor.apply()
+        assertTrue(target.applied)
+    }
+}
