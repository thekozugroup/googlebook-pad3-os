+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_hc_destsize_roundtrip_preserves_both_padding_modes() {
+        let data = vec![7u8; 20081];
+        let mut blocks: Vec<_> = [0, 11889]
+            .into_iter()
+            .map(|offset| CompressedBlockInfo {
+                uncompressed_offset: offset,
+                uncompressed_length: 8192,
+                compressed_length: 4096,
+                ..Default::default()
+            })
+            .collect();
+        blocks.insert(
+            1,
+            CompressedBlockInfo {
+                uncompressed_offset: 8192,
+                uncompressed_length: 3697,
+                compressed_length: 4096,
+                ..Default::default()
+            },
+        );
+        for padding in [false, true] {
+            let packed = compress_blob(
+                &data,
+                &blocks,
+                padding,
+                compression_algorithm::Type::Lz4hc,
+                9,
+            )
+            .unwrap();
+            assert_eq!(packed.len(), 12288);
+            if padding {
+                assert_eq!(packed[0], 0);
+            }
+            assert_eq!(decompress_blob(&packed, &blocks, padding).unwrap(), data);
+        }
+    }
+
+    #[test]
+    fn uncompressed_fragment_applies_postfix_after_padding() {
+        let data = vec![5u8; 3697];
+        let mut raw = data.clone();
+        raw.resize(4096, 0);
+        let mut expected = raw.clone();
+        expected[4095] = 3;
+        let mut patch = Vec::new();
+        bsdiff_android::diff_bsdiff40(&raw, &expected, &mut patch).unwrap();
+        let block = CompressedBlockInfo {
+            uncompressed_offset: 0,
+            uncompressed_length: 3697,
+            compressed_length: 4096,
+            sha256_hash: Sha256::digest(&raw).to_vec(),
+            postfix_bspatch: patch,
+        };
+        assert_eq!(
+            compress_blob(&data, &[block], true, compression_algorithm::Type::Lz4hc, 9).unwrap(),
+            expected
+        );
+    }
+}
